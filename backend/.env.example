# TheraGift Backend — Örnek Ortam Değişkenleri
#
# V2.4.1 GÜNCELLEMESİ: Bu değişkenler artık gerçekten çalışıyor.
# backend/src/main/resources/application.yml içindeki ilgili alanlar
# ${ENV_VAR:local-default} söz dizimiyle tanımlıdır — hiçbir env değişkeni
# verilmezse aşağıdaki ":" sonrası local varsayılan değerler kullanılır ve
# local geliştirme hiçbir .env dosyası olmadan da çalışmaya devam eder.
# Production'da bu değişkenleri ortamınıza (Docker, systemd, PaaS env
# ayarları vb.) tanımlayarak override edebilirsiniz.
#
# Bu dosyayı gerçek `.env` olarak KOPYALAMAYIN ve secret değerleri repoya
# commit etmeyin.

# --- Java / Build ---
# Bu proje Java 17 gerektirir (pom.xml <java.version>17</java.version>).

# --- Sunucu ---
SERVER_PORT=8080

# --- Veritabanı (PostgreSQL) ---
SPRING_PROFILES_ACTIVE=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/theragift_db
SPRING_DATASOURCE_USERNAME=theragift
SPRING_DATASOURCE_PASSWORD=theragift123

# --- JWT ---
# ÖNEMLİ: application.yml içindeki varsayılan değer SADECE local geliştirme
# içindir. Production'da MUTLAKA uzun, rastgele, tahmin edilemez bir secret
# kullanın (örn. `openssl rand -base64 48`) ve asla repoya commit etmeyin.
JWT_SECRET=change-me-to-a-long-random-production-secret
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Frontend'in production URL'i (virgülle birden fazla origin desteklenir,
# örn. "https://app.theragift.com,https://theragift.com").
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Seed / Demo Data ---
# SeedDataRunner uygulama ilk ayağa kalktığında demo psikolog + demo veri
# oluşturur (bkz. README "Seed / Demo Data"). Gerçek danışan verisiyle
# kullanmadan önce SEED_DATA_ENABLED=false ile bu davranış tamamen
# kapatılabilir.
SEED_DATA_ENABLED=true
