# TheraGift — Root Örnek Ortam Değişkenleri (Docker Compose / PostgreSQL)
#
# NOT (V2.4.1'de değişmedi): docker-compose.yml şu anda bu değerleri SABİT
# (hardcoded) tanımlar, bir .env dosyasından OKUMAZ — bu, backend/.env.example
# içindeki (artık gerçekten çalışan) SPRING_DATASOURCE_* değişkenlerinden
# FARKLI bir dosyadır. Bu dosya sadece local Docker container'ının hangi
# DB bilgileriyle ayağa kalktığını dokümante eder; backend'e bağlanırken
# kullanılan gerçek env değişkenleri backend/.env.example içindedir. Ayrıntı
# için bkz. docs/DEPLOYMENT_NOTES.md.

POSTGRES_DB=theragift_db
POSTGRES_USER=theragift
POSTGRES_PASSWORD=theragift123
POSTGRES_PORT=5432

# Bu değerler backend/.env.example içindeki SPRING_DATASOURCE_* değerleriyle
# eşleşmelidir.
